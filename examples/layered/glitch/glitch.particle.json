{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "demo:glitch",
			"basic_render_parameters": {
				"material": "particles_add",
				"texture": "textures/particle/particles"
			}
		},
		"components": {
			"minecraft:emitter_local_space": {
				"position": true,
				"rotation": false
			},
			"minecraft:emitter_rate_steady": {
				"spawn_rate": 45,
				"max_particles": 30
			},
			"minecraft:emitter_lifetime_looping": {
				"active_time": 0.5
			},
			"minecraft:emitter_shape_box": {
				"offset": [
					0,
					"0.9",
					0
				],
				"half_dimensions": [
					"0.45",
					"0.9",
					"0.45"
				]
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": "math.random(0.08, 0.3)"
			},
			"minecraft:particle_appearance_billboard": {
				"size": [
					"0.05 + v.particle_random_1 * 0.09",
					"0.05 + v.particle_random_1 * 0.09"
				],
				"facing_camera_mode": "lookat_xyz",
				"uv": {
					"texture_width": 128,
					"texture_height": 128,
					"uv": [
						19,
						91
					],
					"uv_size": [
						3,
						3
					]
				}
			},
			"minecraft:particle_appearance_tinting": {
				"color": [
					"v.particle_random_2 > 0.5 ? 0 : 1",
					"v.particle_random_2 > 0.5 ? 0.941 : 0.169",
					"v.particle_random_2 > 0.5 ? 1 : 0.839",
					"math.mod(math.floor(v.particle_age * 30), 2) < 1 ? 1 : 0.35"
				]
			},
			"minecraft:emitter_lifetime_events": {
				"timeline": {
					"0.00": [
						"spawn_scanlines"
					]
				}
			}
		},
		"events": {
			"spawn_scanlines": {
				"particle_effect": {
					"effect": "demo:glitch_scanlines",
					"type": "emitter_bound"
				}
			}
		}
	}
}