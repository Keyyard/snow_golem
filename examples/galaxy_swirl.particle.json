{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "demo:galaxy_swirl",
			"basic_render_parameters": {
				"material": "particles_add",
				"texture": "textures/particle/particles"
			}
		},
		"components": {
			"minecraft:emitter_local_space": {
				"position": true,
				"rotation": true
			},
			"minecraft:emitter_rate_steady": {
				"spawn_rate": 55,
				"max_particles": 140
			},
			"minecraft:emitter_lifetime_looping": {
				"active_time": 4
			},
			"minecraft:emitter_shape_point": {},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": 2.5
			},
			"minecraft:particle_motion_parametric": {
				"relative_position": [
					"math.cos(math.floor(v.particle_random_1 * 3) * 120 + math.pow(v.particle_age / v.particle_lifetime, 2) * 540 + v.particle_random_2 * 25) * 1.6 * (1 - v.particle_age / v.particle_lifetime)",
					"math.sin(v.particle_age * 200 + v.particle_random_3 * 360) * 0.06",
					"math.sin(math.floor(v.particle_random_1 * 3) * 120 + math.pow(v.particle_age / v.particle_lifetime, 2) * 540 + v.particle_random_2 * 25) * 1.6 * (1 - v.particle_age / v.particle_lifetime)"
				]
			},
			"minecraft:particle_appearance_billboard": {
				"size": [
					"0.05 + v.particle_age / v.particle_lifetime * 0.1",
					"0.05 + v.particle_age / v.particle_lifetime * 0.1"
				],
				"facing_camera_mode": "rotate_xyz",
				"uv": {
					"texture_width": 128,
					"texture_height": 128,
					"uv": [
						32,
						16
					],
					"uv_size": [
						32,
						32
					]
				}
			},
			"minecraft:particle_appearance_tinting": {
				"color": {
					"interpolant": "v.particle_age / v.particle_lifetime",
					"gradient": {
						"0.0": "#004A2BFF",
						"0.15": "#CC7A5CFF",
						"0.7": "#FFFF9AE8",
						"1.0": "#00FFFFFF"
					}
				}
			}
		}
	}
}
