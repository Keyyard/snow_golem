{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "demo:atom_orbits",
			"basic_render_parameters": {
				"material": "particles_add",
				"texture": "textures/particle/particles"
			}
		},
		"components": {
			"minecraft:emitter_local_space": {
				"position": true,
				"rotation": true
			},
			"minecraft:emitter_rate_steady": {
				"spawn_rate": 45,
				"max_particles": 90
			},
			"minecraft:emitter_lifetime_looping": {
				"active_time": 4
			},
			"minecraft:emitter_shape_point": {},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": 2
			},
			"minecraft:particle_motion_parametric": {
				"relative_position": [
					"math.cos(v.particle_random_2 * 360 + v.particle_age * 360) * 0.9 * math.cos((math.floor(v.particle_random_1 * 3) - 1) * 60)",
					"math.cos(v.particle_random_2 * 360 + v.particle_age * 360) * 0.9 * math.sin((math.floor(v.particle_random_1 * 3) - 1) * 60) + 1",
					"math.sin(v.particle_random_2 * 360 + v.particle_age * 360) * 0.9"
				]
			},
			"minecraft:particle_appearance_billboard": {
				"size": [
					"0.07 * (1.2 - v.particle_age / v.particle_lifetime * 0.6)",
					"0.07 * (1.2 - v.particle_age / v.particle_lifetime * 0.6)"
				],
				"facing_camera_mode": "rotate_xyz",
				"uv": {
					"texture_width": 128,
					"texture_height": 128,
					"uv": [
						19,
						91
					],
					"uv_size": [
						3,
						3
					]
				}
			},
			"minecraft:particle_appearance_tinting": {
				"color": {
					"interpolant": "math.floor(v.particle_random_1 * 3) / 2",
					"gradient": {
						"0.0": "#FF5CE1FF",
						"0.5": "#FFB6FF5C",
						"1.0": "#FFFF8A3D"
					}
				}
			}
		}
	}
}
