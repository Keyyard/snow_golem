{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "demo:vortex",
			"basic_render_parameters": {
				"material": "particles_add",
				"texture": "textures/particle/particles"
			}
		},
		"components": {
			"minecraft:emitter_local_space": {
				"position": true,
				"rotation": false
			},
			"minecraft:emitter_rate_steady": {
				"spawn_rate": 45,
				"max_particles": 70
			},
			"minecraft:emitter_lifetime_looping": {
				"active_time": 1.5
			},
			"minecraft:emitter_shape_point": {},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": 1.3
			},
			"minecraft:particle_motion_parametric": {
				"relative_position": [
					"math.cos(v.particle_random_1 * 360 + v.particle_age * 300) * 1.3 * (1 - v.particle_age / v.particle_lifetime)",
					"v.particle_age * 1.2",
					"math.sin(v.particle_random_1 * 360 + v.particle_age * 300) * 1.3 * (1 - v.particle_age / v.particle_lifetime)"
				]
			},
			"minecraft:particle_appearance_billboard": {
				"size": [
					"0.07",
					"0.07"
				],
				"facing_camera_mode": "rotate_xyz",
				"uv": {
					"texture_width": 128,
					"texture_height": 128,
					"uv": [
						16,
						48
					],
					"uv_size": [
						7,
						7
					]
				}
			},
			"minecraft:particle_appearance_tinting": {
				"color": {
					"interpolant": "v.particle_age / v.particle_lifetime",
					"gradient": {
						"0.00": "#009B4DFF",
						"0.20": "#FF9B4DFF",
						"0.80": "#FF5CE1FF",
						"1.00": "#00FFFFFF"
					}
				}
			},
			"minecraft:emitter_lifetime_events": {
				"timeline": {
					"0.00": [
						"spawn_core",
						"spawn_sigil"
					]
				}
			}
		},
		"events": {
			"spawn_core": {
				"particle_effect": {
					"effect": "demo:vortex_core",
					"type": "emitter_bound"
				}
			},
			"spawn_sigil": {
				"particle_effect": {
					"effect": "demo:vortex_sigil",
					"type": "emitter_bound"
				}
			}
		}
	}
}