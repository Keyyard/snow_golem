{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "demo:aura",
			"basic_render_parameters": {
				"material": "particles_add",
				"texture": "textures/particle/particles"
			}
		},
		"components": {
			"minecraft:emitter_local_space": {
				"position": true,
				"rotation": false
			},
			"minecraft:emitter_rate_steady": {
				"spawn_rate": 14,
				"max_particles": 40
			},
			"minecraft:emitter_lifetime_looping": {
				"active_time": 1
			},
			"minecraft:emitter_shape_disc": {
				"radius": "0.55",
				"plane_normal": [
					0,
					1,
					0
				],
				"offset": [
					0,
					0.05,
					0
				]
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": "math.random(1.0, 1.6)"
			},
			"minecraft:particle_initial_speed": 0,
			"minecraft:particle_motion_dynamic": {
				"linear_acceleration": [
					"math.sin(v.particle_age * 180 + v.particle_random_1 * 360) * 0.4",
					"1.6",
					0
				],
				"linear_drag_coefficient": 1.2
			},
			"minecraft:particle_appearance_billboard": {
				"size": [
					"0.16 * (0.6 + v.particle_random_2 * 0.6)",
					"0.16 * (0.6 + v.particle_random_2 * 0.6)"
				],
				"facing_camera_mode": "rotate_xyz",
				"uv": {
					"texture_width": 128,
					"texture_height": 128,
					"uv": [
						16,
						48
					],
					"uv_size": [
						7,
						7
					]
				}
			},
			"minecraft:particle_appearance_tinting": {
				"color": {
					"interpolant": "v.particle_age / v.particle_lifetime",
					"gradient": {
						"0.00": "#007CF4FF",
						"0.20": "#FFE6FBFF",
						"0.70": "#E67CF4FF",
						"1.00": "#007CF4FF"
					}
				}
			},
			"minecraft:emitter_lifetime_events": {
				"timeline": {
					"0.00": [
						"spawn_band",
						"spawn_glow"
					]
				}
			}
		},
		"events": {
			"spawn_band": {
				"particle_effect": {
					"effect": "demo:aura_band",
					"type": "emitter_bound"
				}
			},
			"spawn_glow": {
				"particle_effect": {
					"effect": "demo:aura_glow",
					"type": "emitter_bound"
				}
			}
		}
	}
}