{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "demo:ember_burst",
			"basic_render_parameters": { "material": "particles_add", "texture": "textures/particle/particles" }
		},
		"components": {
			"minecraft:emitter_rate_instant": { "num_particles": 24 },
			"minecraft:emitter_lifetime_once": { "active_time": 1 },
			"minecraft:emitter_shape_sphere": { "radius": 0.2, "direction": "outwards" },
			"minecraft:particle_initial_speed": "math.random(2, 4)",
			"minecraft:particle_lifetime_expression": { "max_lifetime": "math.random(0.6, 1.0)" },
			"minecraft:particle_motion_dynamic": { "linear_acceleration": [0, -4, 0], "linear_drag_coefficient": 1.5 },
			"minecraft:particle_appearance_billboard": {
				"size": ["0.12 * (1 - v.particle_age / v.particle_lifetime)", "0.12 * (1 - v.particle_age / v.particle_lifetime)"],
				"facing_camera_mode": "rotate_xyz",
				"uv": { "texture_width": 128, "texture_height": 128, "uv": [0, 88], "uv_size": [8, 8] }
			},
			"minecraft:particle_appearance_tinting": {
				"color": { "interpolant": "v.particle_age / v.particle_lifetime", "gradient": { "0.0": "#FFFFD27A", "0.5": "#FFFF7A1F", "1.0": "#00B3200A" } }
			}
		}
	}
}
