			"spawn_sparks": {
				"particle_effect": {
					"effect": "demo:explosion_sparks",
					"type": "emitter"
				}
			},
			"spawn_smoke": {
				"particle_effect": {
					"effect": "demo:explosion_smoke",
					"type": "emitter"
				}
			}
