{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "demo:dna_helix",
			"basic_render_parameters": {
				"material": "particles_add",
				"texture": "textures/particle/particles"
			}
		},
		"components": {
			"minecraft:emitter_local_space": {
				"position": true,
				"rotation": true
			},
			"minecraft:emitter_rate_steady": {
				"spawn_rate": 40,
				"max_particles": 120
			},
			"minecraft:emitter_lifetime_looping": {
				"active_time": 4
			},
			"minecraft:emitter_shape_point": {},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": 3
			},
			"minecraft:particle_motion_parametric": {
				"relative_position": [
					"math.cos(v.particle_age * 150 + math.floor(v.particle_random_1 * 2) * 180) * 0.6",
					"v.particle_age * 0.9",
					"math.sin(v.particle_age * 150 + math.floor(v.particle_random_1 * 2) * 180) * 0.6"
				]
			},
			"minecraft:particle_appearance_billboard": {
				"size": [
					"0.09 + math.sin(v.particle_age * 600) * 0.02",
					"0.09 + math.sin(v.particle_age * 600) * 0.02"
				],
				"facing_camera_mode": "rotate_xyz",
				"uv": {
					"texture_width": 128,
					"texture_height": 128,
					"uv": [
						16,
						48
					],
					"uv_size": [
						7,
						7
					]
				}
			},
			"minecraft:particle_appearance_tinting": {
				"color": [
					"math.floor(v.particle_random_1 * 2)",
					"0.9 - math.floor(v.particle_random_1 * 2) * 0.65",
					"1 - math.floor(v.particle_random_1 * 2) * 0.1",
					"math.clamp(math.min(v.particle_age / v.particle_lifetime, 1 - v.particle_age / v.particle_lifetime) * 6, 0, 1)"
				]
			}
		}
	}
}
