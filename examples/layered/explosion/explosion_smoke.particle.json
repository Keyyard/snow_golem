{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "demo:explosion_smoke",
			"basic_render_parameters": {
				"material": "particles_blend",
				"texture": "textures/particle/campfire_smoke"
			}
		},
		"components": {
			"minecraft:emitter_rate_instant": {
				"num_particles": 9
			},
			"minecraft:emitter_lifetime_once": {
				"active_time": 0.25
			},
			"minecraft:emitter_shape_sphere": {
				"radius": "0.6",
				"direction": "outwards"
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": "math.random(1.4, 2.4)"
			},
			"minecraft:particle_initial_speed": "1.2",
			"minecraft:particle_motion_dynamic": {
				"linear_acceleration": [
					0,
					"1.6",
					0
				],
				"linear_drag_coefficient": 1.2
			},
			"minecraft:particle_initial_spin": {
				"rotation": "math.random(0, 360)",
				"rotation_rate": "math.random(-20, 20)"
			},
			"minecraft:particle_appearance_billboard": {
				"size": [
					"1.1 * (0.6 + v.particle_age / v.particle_lifetime)",
					"1.1 * (0.6 + v.particle_age / v.particle_lifetime)"
				],
				"facing_camera_mode": "rotate_xyz",
				"uv": {
					"texture_width": 16,
					"texture_height": 192,
					"flipbook": {
						"base_UV": [
							0,
							0
						],
						"size_UV": [
							16,
							16
						],
						"step_UV": [
							0,
							16
						],
						"max_frame": 12,
						"stretch_to_lifetime": true,
						"loop": false
					}
				}
			},
			"minecraft:particle_appearance_tinting": {
				"color": {
					"interpolant": "v.particle_age / v.particle_lifetime",
					"gradient": {
						"0.00": "#006A6464",
						"0.10": "#BF6A6464",
						"1.00": "#004A4646"
					}
				}
			}
		}
